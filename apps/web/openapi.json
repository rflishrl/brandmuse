{
  "openapi": "3.1.0",
  "info": {
    "title": "BrandMuse API",
    "description": "FastAPI Backend for BrandMuse - AI Brand Assistant for Creative Teams",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service Health Check",
        "description": "Returns current server status, active provider names, and database connectivity.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Upload Brand Guideline PDF",
        "description": "Streams and validates a guideline PDF (max 10MB, max 40 pages), then indexes it.",
        "operationId": "uploadDocument",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_uploadDocument"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "List Brand Guidelines",
        "description": "Returns guidelines uploaded by the current session plus the shared sample brand.",
        "operationId": "listDocuments",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/sample": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Load Sample Brand Guideline",
        "description": "Loads the preloaded sample brand guideline ('Aura Living') for demo interaction.",
        "operationId": "loadSampleBrand",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Stream Grounded Chat Answer",
        "description": "Streams token-by-token answer via Server-Sent Events (SSE) grounded in retrieved brand guidelines, concluding with citations (page + snippet) and Langfuse trace link.",
        "operationId": "streamChat",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events stream: 'event: token', 'event: done', 'event: error'",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_uploadDocument": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_uploadDocument"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "description": "Message author role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "title": "Content",
            "description": "Text content of the message"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "description": "Chat message history entry."
      },
      "ChatRequest": {
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id",
            "description": "Target brand guideline document ID"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "description": "User question regarding brand guidelines"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 10,
            "title": "History",
            "description": "Recent conversation turns (max 10)",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "message"
        ],
        "title": "ChatRequest",
        "description": "Incoming user chat query for guideline grounded Q&A."
      },
      "DocumentListResponse": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentResponse"
            },
            "type": "array",
            "title": "Documents",
            "description": "Session guidelines plus sample brand"
          }
        },
        "type": "object",
        "required": [
          "documents"
        ],
        "title": "DocumentListResponse",
        "description": "List of documents accessible in the current session."
      },
      "DocumentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Unique document ID"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "Original filename of the guideline"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count",
            "description": "Total pages extracted from the PDF"
          },
          "is_sample": {
            "type": "boolean",
            "title": "Is Sample",
            "description": "Whether this is the preloaded sample brand guideline"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp of document ingestion"
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "page_count",
          "is_sample",
          "created_at"
        ],
        "title": "DocumentResponse",
        "description": "Document representation schema."
      },
      "DocumentUploadResponse": {
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentResponse",
            "description": "Ingested document details"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count",
            "description": "Total indexed text chunks created"
          }
        },
        "type": "object",
        "required": [
          "document",
          "chunk_count"
        ],
        "title": "DocumentUploadResponse",
        "description": "Response returned upon successful PDF upload and ingestion."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall service status ('ok', 'degraded', 'error')",
            "examples": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "title": "Database",
            "description": "Database connectivity status",
            "examples": [
              "connected"
            ]
          },
          "providers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Providers",
            "description": "Active AI and storage providers",
            "examples": [
              {
                "embeddings": "openai",
                "image": "stability",
                "llm": "openai"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "providers"
        ],
        "title": "HealthResponse",
        "description": "Health check response schema."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}