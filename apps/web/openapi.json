{
  "openapi": "3.1.0",
  "info": {
    "title": "BrandMuse API",
    "description": "FastAPI Backend for BrandMuse - AI Brand Assistant for Creative Teams",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service Health Check",
        "description": "Returns current server status, active provider names, and database connectivity.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Upload Brand Guideline PDF",
        "description": "Streams and validates a guideline PDF (max 10MB, max 40 pages), then indexes it.",
        "operationId": "uploadDocument",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_uploadDocument"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "List Brand Guidelines",
        "description": "Returns guidelines uploaded by the current session plus the shared sample brand.",
        "operationId": "listDocuments",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/sample": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Load Sample Brand Guideline",
        "description": "Loads the preloaded sample brand guideline ('Aura Living') for demo interaction.",
        "operationId": "loadSampleBrand",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Stream Grounded Chat Answer",
        "description": "Streams token-by-token answer via Server-Sent Events (SSE) grounded in retrieved brand guidelines, concluding with citations (page + snippet) and Langfuse trace link.",
        "operationId": "streamChat",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events: 'event: token', 'event: done', 'event: error'",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/campaign": {
      "post": {
        "tags": [
          "campaign"
        ],
        "summary": "Generate 3 creative on-brand campaign concepts",
        "description": "Generate 3 distinct creative concepts grounded strictly in uploaded brand guidelines.",
        "operationId": "generateCampaign",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CampaignRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/images": {
      "post": {
        "tags": [
          "images"
        ],
        "summary": "Generate Stable Diffusion visual asset for a campaign concept",
        "description": "Generate image with safety moderation, rate limits, and Supabase Storage persistence.",
        "operationId": "generateImage",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageGenerateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageGenerateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "images"
        ],
        "summary": "Retrieve all generated assets for the active user session",
        "description": "List all images generated within the current isolated session ordered newest first.",
        "operationId": "getGallery",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client session identifier as UUID",
              "title": "X-Session-Id"
            },
            "description": "Client session identifier as UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GalleryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_uploadDocument": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_uploadDocument"
      },
      "CampaignBrief": {
        "properties": {
          "product": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Product",
            "description": "The product, service, or initiative being launched or promoted"
          },
          "audience": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Audience",
            "description": "Target customer demographic or persona"
          },
          "channel": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Channel",
            "description": "Target primary channel, e.g. Instagram, LinkedIn, Outdoor, or Email"
          },
          "mood": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Mood",
            "description": "Desired campaign mood or angle, e.g. serene, bold, playful, or minimalist"
          }
        },
        "type": "object",
        "required": [
          "product",
          "audience",
          "channel",
          "mood"
        ],
        "title": "CampaignBrief",
        "description": "User input brief for generating on-brand campaign concepts."
      },
      "CampaignRequest": {
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id",
            "description": "Target brand guideline document ID"
          },
          "brief": {
            "$ref": "#/components/schemas/CampaignBrief",
            "description": "Campaign brief requirements"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "brief"
        ],
        "title": "CampaignRequest",
        "description": "Incoming request to generate 3 brand-aligned creative concepts."
      },
      "CampaignResponse": {
        "properties": {
          "concepts": {
            "items": {
              "$ref": "#/components/schemas/Concept"
            },
            "type": "array",
            "title": "Concepts",
            "description": "Generated campaign concepts"
          },
          "brand_rules_used": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Brand Rules Used",
            "description": "Aggregated brand guideline rules applied across the concepts",
            "default": []
          },
          "trace_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Url",
            "description": "Direct URL to Langfuse trace for auditability"
          }
        },
        "type": "object",
        "required": [
          "concepts"
        ],
        "title": "CampaignResponse",
        "description": "Response containing 3 creative concepts with guideline citations and trace link."
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "description": "Message author role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "title": "Content",
            "description": "Text content of the message"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "description": "Chat message history entry."
      },
      "ChatRequest": {
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id",
            "description": "Target brand guideline document ID"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "description": "User question regarding brand guidelines"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 10,
            "title": "History",
            "description": "Recent conversation turns (max 10)",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "message"
        ],
        "title": "ChatRequest",
        "description": "Incoming user chat query for guideline grounded Q&A."
      },
      "Concept": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Catchy campaign headline or concept title"
          },
          "caption": {
            "type": "string",
            "title": "Caption",
            "description": "Social/ad copywriting caption aligned with brand voice"
          },
          "hashtags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hashtags",
            "description": "Relevant campaign hashtags (3 to 5 tags)",
            "default": []
          },
          "visual_direction": {
            "type": "string",
            "title": "Visual Direction",
            "description": "Art direction notes detailing lighting, color mood, and scene composition"
          },
          "image_prompt": {
            "type": "string",
            "title": "Image Prompt",
            "description": "Optimized Stable Diffusion prompt describing the scene in pure visual tokens. Never include rendered text, watermarks, or celebrity names."
          },
          "brand_rules_used": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Brand Rules Used",
            "description": "Specific brand guideline rules and colors incorporated into this concept",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "title",
          "caption",
          "visual_direction",
          "image_prompt"
        ],
        "title": "Concept",
        "description": "A generated marketing campaign concept grounded in brand guidelines."
      },
      "DocumentListResponse": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentResponse"
            },
            "type": "array",
            "title": "Documents",
            "description": "Session guidelines plus sample brand"
          }
        },
        "type": "object",
        "required": [
          "documents"
        ],
        "title": "DocumentListResponse",
        "description": "List of documents accessible in the current session."
      },
      "DocumentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Unique document ID"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "Original filename of the guideline"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count",
            "description": "Total pages extracted from the PDF"
          },
          "is_sample": {
            "type": "boolean",
            "title": "Is Sample",
            "description": "Whether this is the preloaded sample brand guideline"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp of document ingestion"
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "page_count",
          "is_sample",
          "created_at"
        ],
        "title": "DocumentResponse",
        "description": "Document representation schema."
      },
      "DocumentUploadResponse": {
        "properties": {
          "document": {
            "$ref": "#/components/schemas/DocumentResponse",
            "description": "Ingested document details"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count",
            "description": "Total indexed text chunks created"
          }
        },
        "type": "object",
        "required": [
          "document",
          "chunk_count"
        ],
        "title": "DocumentUploadResponse",
        "description": "Response returned upon successful PDF upload and ingestion."
      },
      "GalleryResponse": {
        "properties": {
          "generations": {
            "items": {
              "$ref": "#/components/schemas/GenerationItem"
            },
            "type": "array",
            "title": "Generations",
            "description": "All image generations belonging to this session",
            "default": []
          }
        },
        "type": "object",
        "title": "GalleryResponse",
        "description": "List of all generated assets created within the active session."
      },
      "GenerationItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Generation ID"
          },
          "concept_title": {
            "type": "string",
            "title": "Concept Title",
            "description": "Associated concept title"
          },
          "concept_json": {
            "additionalProperties": true,
            "type": "object",
            "title": "Concept Json",
            "description": "Stored concept metadata"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url",
            "description": "Permanent public image URL"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "Image provider used, e.g. stability or replicate"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp of generation"
          }
        },
        "type": "object",
        "required": [
          "id",
          "concept_title",
          "image_url",
          "provider",
          "created_at"
        ],
        "title": "GenerationItem",
        "description": "Persisted generation record item for gallery views."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall service status ('ok', 'degraded', 'error')",
            "examples": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "title": "Database",
            "description": "Database connectivity status",
            "examples": [
              "connected"
            ]
          },
          "providers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Providers",
            "description": "Active AI and storage providers",
            "examples": [
              {
                "embeddings": "openai",
                "image": "stability",
                "llm": "openai"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "providers"
        ],
        "title": "HealthResponse",
        "description": "Health check response schema."
      },
      "ImageGenerateRequest": {
        "properties": {
          "image_prompt": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Image Prompt",
            "description": "Detailed visual prompt describing the scene"
          },
          "concept_title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Concept Title",
            "description": "Associated creative concept title"
          },
          "concept_json": {
            "additionalProperties": true,
            "type": "object",
            "title": "Concept Json",
            "description": "Full concept metadata object for gallery persistence"
          }
        },
        "type": "object",
        "required": [
          "image_prompt",
          "concept_title"
        ],
        "title": "ImageGenerateRequest",
        "description": "Request payload to synthesize an image asset using Stable Diffusion."
      },
      "ImageGenerateResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Unique generation record identifier"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Permanent public HTTPS URL of the generated asset"
          }
        },
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "title": "ImageGenerateResponse",
        "description": "Result of image generation including permanent public Supabase Storage URL."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}