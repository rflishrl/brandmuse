# ==============================================================================
# BrandMuse Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# --- Server & Networking ---
PORT=8000
ENVIRONMENT=development
# Comma-separated allowed origins for CORS. In production, set to exact Cloudflare Pages origin (no wildcards).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Database & Storage (PostgreSQL + pgvector) ---
# Async connection string for FastAPI application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brandmuse
# Direct connection string for running Alembic migrations (e.g. psycopg or asyncpg)
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brandmuse
# Set to 'true' when connecting to Supabase transaction pooler (port 6543)
# Disables prepared statements (statement_cache_size=0) and uses NullPool
DB_POOLER_MODE=false
# Full-text search dictionary configuration ('english' default, or 'simple' for multilingual/Indonesian)
FTS_CONFIG=english

# --- AI & Embeddings Providers ---
# LLM: 'openai' | 'ollama'
LLM_PROVIDER=openai
# Embeddings: 'openai' | 'ollama'
EMBEDDING_PROVIDER=openai
# Embedding dimension: 1536 for OpenAI text-embedding-3-small, 768 for Ollama nomic-embed-text
EMBEDDING_DIM=1536
# Images: 'stability' | 'replicate'
IMAGE_PROVIDER=stability

# --- Provider Credentials ---
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
STABILITY_API_KEY=your_stability_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# --- Permanent Storage (Supabase Storage for Generated Images) ---
SUPABASE_URL=https://your-project.supabase.co
# Server-only service role key used by API to upload generated images to public bucket (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=brandmuse-images

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_URL=https://cloud.langfuse.com
# Privacy toggle: false = trace only metadata for user uploads; true = trace raw text
TRACE_USER_CONTENT=false

# --- Safety, Rate Limiting & Usage Caps ---
DAILY_LLM_LIMIT=200
DAILY_IMAGE_LIMIT=25
SESSION_IMAGE_HOURLY_LIMIT=5
RATE_LIMIT_PER_MINUTE=30

# --- Frontend Web (.env for apps/web) ---
VITE_API_URL=http://localhost:8000
