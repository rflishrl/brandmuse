# ==============================================================================
# BrandMuse Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# --- Server & Networking ---
PORT=8000
ENVIRONMENT=development
# Comma-separated allowed origins for CORS. In production, set to exact Cloudflare Pages origin (no wildcards).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Database & Storage (PostgreSQL + pgvector) ---
# Async connection string for FastAPI application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brandmuse
# Direct connection string for running Alembic migrations (e.g. psycopg or asyncpg)
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brandmuse
# Set to 'true' when connecting to Neon / PgBouncer transaction pooler
# Disables prepared statements (statement_cache_size=0)
DB_POOLER_MODE=false
# Full-text search dictionary configuration ('english' default, or 'simple' for multilingual/Indonesian)
FTS_CONFIG=english

# --- AI & Embeddings Providers ---
# LLM: 'gemini' (100% Free via Google AI Studio) | 'openai' | 'ollama'
LLM_PROVIDER=gemini
# Embeddings: 'gemini' (100% Free via Google AI Studio) | 'openai' | 'ollama'
EMBEDDING_PROVIDER=gemini
# Embedding dimension: 1536 for OpenAI / zero-padded Gemini, 768 for Ollama nomic-embed-text
EMBEDDING_DIM=1536
# Images: 'mock' (100% Free synthetic canvas) | 'stability' | 'replicate'
IMAGE_PROVIDER=mock

# --- Provider Credentials ---
# Google Gemini API Key (100% Free from https://aistudio.google.com - NO credit card needed)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
STABILITY_API_KEY=your_stability_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# --- Permanent Storage (Cloudflare R2 for Generated Images) ---
# Active storage provider: 'auto' | 'r2' | 'local'
STORAGE_PROVIDER=auto

# Cloudflare R2 (Recommended for 10 GB free forever & zero egress fees)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=brandmuse-images
# Public R2 bucket URL (managed r2.dev subdomain or custom domain like https://assets.yourdomain.com)
R2_PUBLIC_URL=https://pub-yourhash.r2.dev

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_URL=https://cloud.langfuse.com
# Privacy toggle: false = trace only metadata for user uploads; true = trace raw text
TRACE_USER_CONTENT=false

# --- Safety, Rate Limiting & Usage Caps ---
DAILY_LLM_LIMIT=200
DAILY_IMAGE_LIMIT=25
SESSION_IMAGE_HOURLY_LIMIT=5
RATE_LIMIT_PER_MINUTE=30

# --- Frontend Web (.env for apps/web) ---
VITE_API_URL=http://localhost:8000
